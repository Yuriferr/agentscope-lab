HOST=127.0.0.1
PORT=4310
DATA_DIR=./data
# Extra origins the local runner may contact. The OpenAI, Gemini, Ollama and
# LM Studio presets are already permitted. No wildcard, no redirects.
AGENT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:11434,http://127.0.0.1:11434
# Optional: name this environment variable in an HTTP agent's tokenEnv field.
# MY_AGENT_TOKEN=
